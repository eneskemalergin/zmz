          <scan><cvParam cvRef="mass-spec" accession="MS:1000016" name="scan start time" value="1.25" unitCvRef="units" unitAccession="UO:0000031" unitName="minute"/></scan>
          <scan><cvParam cvRef="mass-spec" accession="MS:1000016" name="scan start time" value="76" unitCvRef="units" unitAccession="UO:0000010" unitName="second"/></scan>
        </scanList>
        <precursorList count="2">
          <precursor>
