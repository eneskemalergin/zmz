              <cvParam cvRef="mass-spec" accession="MS:1000598" name="electron transfer dissociation"/>
              <cvParam cvRef="mass-spec" accession="MS:1000045" name="collision energy" value="30" unitCvRef="units" unitAccession="UO:0000266" unitName="electronvolt"/>
