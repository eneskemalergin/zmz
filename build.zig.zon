.{
    .name = .zmz,
    .version = "0.0.0",
    .dependencies = .{
        .zipir = .{
            .url = "https://github.com/eneskemalergin/zipir/releases/download/v0.2.1/zipir-0.2.1-source.tar.gz",
            .hash = "zipir-0.2.1-_67xOQ3vJQDjpQJwgWVKo3sZr5JZrLKw17p3oBUUFGKm",
        },
    },
    .fingerprint = 0xc6a4b95cef75bbdc,
    .minimum_zig_version = "0.16.0",
    // What a dependent build needs: the library and its notices. Tests, examples, tools, and
    // vocabulary sources stay in the repository; their build steps are never run from a package.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
        "NOTICE",
    },
}
